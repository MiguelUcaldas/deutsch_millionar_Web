{
  "tipo": "regla",
  "titulo": "Hora informal (en la conversación)",
  "puntos": [
    {
      "id": "en_punto",
      "minutos": [0, 0],
      "texto": "En punto: número + Uhr.",
      "ejemplos": [
        {
          "original": "drei Uhr",
          "traduccion": "3:00"
        }
      ]
    },
    {
      "id": "nach",
      "minutos": [1, 20],
      "texto": "Minutos después de la hora: X nach.",
      "ejemplos": [
        {
          "original": "zehn nach zwei",
          "traduccion": "2:10"
        }
      ]
    },
    {
      "id": "viertel_nach",
      "minutos": [15, 15],
      "texto": "Un cuarto después: Viertel nach.",
      "ejemplos": [
        {
          "original": "Viertel nach drei",
          "traduccion": "3:15"
        }
      ]
    },
    {
      "id": "vor_halb",
      "minutos": [21, 29],
      "texto": "Antes de la media: X vor halb + la hora SIGUIENTE.",
      "ejemplos": [
        {
          "original": "fünf vor halb zwei",
          "traduccion": "1:25"
        }
      ]
    },
    {
      "id": "halb",
      "minutos": [30, 30],
      "texto": "halb + la hora SIGUIENTE: es media hora antes de esa hora.",
      "ejemplos": [
        {
          "original": "halb drei",
          "traduccion": "2:30 (no 3:30)"
        }
      ]
    },
    {
      "id": "nach_halb",
      "minutos": [31, 39],
      "texto": "Después de la media: X nach halb + la hora SIGUIENTE.",
      "ejemplos": [
        {
          "original": "fünf nach halb acht",
          "traduccion": "7:35"
        }
      ]
    },
    {
      "id": "vor",
      "minutos": [40, 59],
      "texto": "Minutos antes de la hora siguiente: X vor.",
      "ejemplos": [
        {
          "original": "zwanzig vor zehn",
          "traduccion": "9:40"
        }
      ]
    },
    {
      "id": "viertel_vor",
      "minutos": [45, 45],
      "texto": "Un cuarto antes: Viertel vor.",
      "ejemplos": [
        {
          "original": "Viertel vor sieben",
          "traduccion": "6:45"
        }
      ]
    }
  ],
  "nota": "Los rangos de 'minutos' sirven para colorear la zona en el reloj analógico."
}
