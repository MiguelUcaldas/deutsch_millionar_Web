          "id": "inversion",
          "texto": "Inversión",
          "celdas": {
            "conectores": "deshalb, trotzdem",
            "verbo": "Va justo después del conector, antes del sujeto",
            "ejemplo": "..., deshalb bleibe ich zu Hause."
          }
        }
      ],
      "nota": "weil y denn significan lo mismo (porque); la diferencia es solo la posición del verbo."
