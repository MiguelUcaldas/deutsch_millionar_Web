    "verbos_separables": {
      "tipo": "regla",
      "titulo": "Dónde va el prefijo de un verbo separable",
      "puntos": [
        {
          "id": "principal",
          "texto": "Oración normal: el verbo conjugado en posición 2 y el prefijo al final.",
          "ejemplos": [
            {
              "de": "Ich stehe um 7 Uhr auf.",
              "es": "Me levanto a las 7."
            }
          ]
        },
        {
          "id": "pregunta",
          "texto": "Pregunta: el verbo conjugado al inicio o después de la palabra interrogativa, y el prefijo al final.",
          "ejemplos": [
            {
              "de": "Wann fängt der Film an?",
              "es": "¿A qué hora empieza la película?"
            }
          ]
        },
        {
          "id": "subordinada",
          "texto": "Después de weil, dass, wann...: el verbo va al final y el prefijo se vuelve a unir.",
          "ejemplos": [
            {
              "de": "..., weil ich früh aufstehe.",
              "es": "..., porque me levanto temprano."
            }
          ]
        }
      ]
    },
