{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "$schema": {
        "type": "string"
      },
      "id": {
        "type": "string",
        "minLength": 1
      },
      "nivel": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "enunciado": {
        "type": "string",
        "minLength": 1
      },
      "subtitulo": {
        "type": "string"
      },
      "opciones": {
        "minItems": 4,
        "maxItems": 4,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "correcta": {
        "type": "string",
        "minLength": 1
      },
      "explicacion": {
        "type": "string",
        "minLength": 1
      },
      "traduccion": {
        "type": "string"
      },
      "oracion_completa": {
        "type": "string"
      },
      "mantener_orden": {
        "type": "boolean"
      },
      "pronunciar": {
        "type": "string"
      },
      "apoyo": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "tipo"
        ],
        "additionalProperties": {}
      },
      "ficha": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "tipo": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "tipo"
            ],
            "additionalProperties": {}
          }
        ]
      },
      "resaltar": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "flecha": {
        "type": "array",
        "items": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "additionalItems": false,
        "minItems": 2,
        "maxItems": 2
      },
      "estructura": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "texto": {
              "type": "string",
              "minLength": 1
            },
            "etiqueta": {
              "type": "string",
              "minLength": 1
            },
            "resaltar": {
              "type": "boolean"
            }
          },
          "required": [
            "texto",
            "etiqueta"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "nivel",
      "enunciado",
      "opciones",
      "correcta",
      "explicacion"
    ],
    "additionalProperties": false
  }
}
